{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet run:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet new:*)",
      "Bash(dotnet sln:*)",
      "Bash(dotnet add:*)",
      "Bash(dotnet ef:*)",
      "Bash(docker compose:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/appsettings.Production.json)",
      "Read(**/*.pem)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)",

      "Read(docs/design/assets/js/**)",
      "Read(docs/design/assets/fonts/**)",
      "Read(docs/design/assets/**/*.min.css)",
      "Read(docs/design/assets/**/bootstrap*)",
      "Read(docs/design/assets/**/boxicons*)",
      "Read(docs/design/assets/**/flaticon*)",
      "Read(docs/design/assets/**/owl*)",
      "Read(docs/design/assets/**/animate*)",

      "Read(**/wwwroot/lib/**)",
      "Read(**/*.min.js)",
      "Read(**/*.min.css)"
    ]
  }
}
