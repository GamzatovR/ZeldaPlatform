<Project>

  <!--
    Central Package Management: версии пакетов задаются здесь один раз,
    в проектах остаётся <PackageReference Include="..." /> без Version (docs/SPEC.md §2).
    Перечислен весь стек проекта; каждая фаза только добавляет ссылку в нужный csproj.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Фаза 1: EF Core, PostgreSQL -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <!-- Инфраструктурные абстракции для composition root -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <!-- Фаза 2: CQRS, валидация, маппинг -->
  <ItemGroup>
    <!-- MediatR 12.5.0 — последняя версия под Apache-2.0, см. docs/adr/ADR-0002. -->
    <PackageVersion Include="MediatR" Version="12.5.0" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="Mapster" Version="10.0.12" />
    <PackageVersion Include="Mapster.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <!-- Фаза 3: Identity. Готовый Identity.UI не подключается: страницы аккаунта
       свои, иначе их нельзя сверстать по макету и локализовать (docs/adr/ADR-0006). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
  </ItemGroup>

  <!-- Фаза 3: SMTP. MailKit под MIT; System.Net.Mail.SmtpClient не рекомендуется
       для нового кода самой Microsoft, см. docs/adr/ADR-0006. -->
  <ItemGroup>
    <PackageVersion Include="MailKit" Version="4.17.0" />
  </ItemGroup>

  <!-- Фаза 3: QR-код для подключения аутентификатора (docs/SPEC.md §8.2).
       QRCoder под MIT, рисует SVG на сервере — клиентская библиотека не нужна. -->
  <ItemGroup>
    <PackageVersion Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <!-- Фаза 5: SCSS собирается dart-sass'ом через MSBuild. Бинарник приходит
       NuGet-пакетом под нужный RID, поэтому Node не нужен ни в CI, ни в Dockerfile.
       Минификацию и бандлинг поверх собранного CSS добавит WebOptimizer в Фазе 11. -->
  <ItemGroup>
    <PackageVersion Include="AspNetCore.SassCompiler" Version="1.103.0" />
  </ItemGroup>

  <!-- Фазы 10-11: Mongo, логи, санитизация, бандлинг -->
  <ItemGroup>
    <PackageVersion Include="MongoDB.Driver" Version="3.11.1" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Sinks.MongoDB" Version="7.3.0" />
    <PackageVersion Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageVersion Include="LigerShark.WebOptimizer.Core" Version="3.0.477" />
  </ItemGroup>

  <!-- Тесты (§2: Shouldly вместо FluentAssertions, см. docs/adr/ADR-0002) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>

</Project>
