# Скопировать в deploy/.env и при необходимости поправить.
# Сам deploy/.env в репозиторий не попадает (docs/SPEC.md §16).

POSTGRES_DB=zeldaarena
POSTGRES_USER=zeldaarena
POSTGRES_PASSWORD=zeldaarena_dev
# 5432 занят локальным PostgreSQL, наружу пробрасывается 5433
POSTGRES_PORT=5433

MONGO_DATABASE=zeldaarena
MONGO_PORT=27017

MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
