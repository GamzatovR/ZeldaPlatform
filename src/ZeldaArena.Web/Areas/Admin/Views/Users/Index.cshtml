@using Microsoft.AspNetCore.Mvc.Localization
@using ZeldaArena.Application.Common.Models
@using ZeldaArena.Application.Features.Admin.Users.Queries.GetUsersForAdmin
@using ZeldaArena.Domain.Constants
@model ZeldaArena.Web.Areas.Admin.Models.Users.UserIndexViewModel
@inject IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["admin.nav.users"].Value;
    var filter = Model.Filter;
}

<div class="admin-toolbar">
    <h1 class="admin-heading">@T["admin.nav.users"]</h1>
</div>

<form class="filters" method="get" asp-action="Index" role="search" data-filter-form aria-label="@T["filter.title"]">
    <div class="row g-3">
        <div class="col-12 col-md-6 col-xl-3">
            <label class="form-label" for="search">@T["filter.search"]</label>
            <input class="form-control" id="search" name="search" type="search" value="@filter.Search"
                   maxlength="@GetUsersForAdminQueryValidator.MaxSearchLength" />
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <label class="form-label" for="role">@T["admin.user.role"]</label>
            <select class="form-select" id="role" name="role">
                <option value="">@T["filter.any"]</option>
                @foreach (var role in RoleNames.All)
                {
                    <option value="@role" selected="@(filter.Role == role)">@role</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-6 col-xl-2">
            <label class="form-label" for="isBlocked">@T["admin.user.access"]</label>
            <select class="form-select" id="isBlocked" name="isBlocked">
                <option value="">@T["filter.any"]</option>
                <option value="false" selected="@(filter.IsBlocked == false)">@T["admin.user.active"]</option>
                <option value="true" selected="@(filter.IsBlocked == true)">@T["admin.user.blocked_filter"]</option>
            </select>
        </div>
        <div class="col-12 col-md-6 col-xl-2">
            <label class="form-label" for="sort">@T["filter.sort"]</label>
            <select class="form-select" id="sort" name="sort" data-default="@AdminUserSorting.EmailAscending" data-no-chip>
                <option value="@AdminUserSorting.EmailAscending" selected="@(Model.Sort == AdminUserSorting.EmailAscending)">@T["admin.user.sort.email"]</option>
                <option value="@AdminUserSorting.NewestFirst" selected="@(Model.Sort == AdminUserSorting.NewestFirst)">@T["admin.user.sort.newest"]</option>
            </select>
        </div>
        <div class="col-12 col-md-6 col-xl-2">
            <label class="form-label" for="pageSize">@T["filter.page_size"]</label>
            <select class="form-select" id="pageSize" name="pageSize" data-default="@PageSizes.Default" data-no-chip>
                @foreach (var size in PageSizes.Allowed)
                {
                    <option value="@size" selected="@(size == filter.NormalizedPageSize)">@size</option>
                }
            </select>
        </div>
    </div>

    <div class="chips" data-filter-chips tabindex="-1" role="group" hidden
         aria-label="@T["filter.active"]" data-remove-label="@T["filter.remove_chip"]"></div>

    <div class="filters__actions">
        <button class="btn-solid" type="submit">@T["filter.apply"]</button>
        <a class="filters__reset" asp-action="Index" data-filter-reset>@T["filter.reset"]</a>
    </div>
</form>

<div id="user-table" data-list data-api="@Url.Action("Index", "AdminUsersApi", new { area = "Api" })">
    <partial name="_UserTable" model="Model" />
</div>
