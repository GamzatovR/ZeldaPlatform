@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Mvc.Localization
@using ZeldaArena.Web.Areas.Admin
@inject IHtmlLocalizer<SharedResource> T
@inject IAuthorizationService Authorization

@*
    Пункт виден, только если его политика пропускает текущего пользователя: модератор
    не видит тарифов и пользователей (§8.1). Это удобство, а не защита — доступ
    к разделу проверяет политика на самом контроллере.

    IAuthorizationService берётся во вьюхе: ViewComponent может принимать только
    ISender, IStringLocalizer и ILogger (правило 4 §5.2, распространено в Фазе 5).
*@
<nav class="admin-nav">
    <ul class="admin-nav__list">
        @foreach (var item in AdminNavigation.Items)
        {
            if (!(await Authorization.AuthorizeAsync(User, item.Policy)).Succeeded)
            {
                continue;
            }

            <li>
                <a class="admin-nav__link"
                   asp-area="Admin"
                   asp-controller="@item.Controller"
                   asp-action="Index"
                   active-controller="@item.Controller">
                    <icon name="@item.Icon" />
                    <span>@T[item.ResourceKey]</span>
                </a>
            </li>
        }
    </ul>
</nav>
