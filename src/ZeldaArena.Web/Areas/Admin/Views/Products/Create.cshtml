@using Microsoft.AspNetCore.Mvc.Localization
@model ZeldaArena.Web.Areas.Admin.Models.Shop.ProductCreateViewModel
@inject IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["admin.product.create"].Value;
    ViewData["IsNew"] = true;
    ViewData["Categories"] = Model.Categories;
}

<div class="admin-toolbar">
    <h1 class="admin-heading">@T["admin.product.create"]</h1>
    <a class="link-underline" asp-action="Index">@T["admin.back_to_list"]</a>
</div>

<div class="form-card admin-form">
    @if (Model.Categories.Count == 0)
    {
        <p class="admin-panel__empty">@T["admin.product.no_categories"]</p>
    }
    else
    {
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="mb-3"></div>

            <partial name="_ProductFields" for="Form" view-data="ViewData" />

            <div class="admin-form__actions">
                <button class="btn-solid" type="submit">@T["admin.create"]</button>
            </div>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/file-validation.js" asp-append-version="true"></script>
}
