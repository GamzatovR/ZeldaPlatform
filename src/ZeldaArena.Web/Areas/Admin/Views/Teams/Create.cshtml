@using Microsoft.AspNetCore.Mvc.Localization
@model ZeldaArena.Web.Areas.Admin.Models.Teams.TeamFormViewModel
@inject IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["admin.team.create"].Value;
}

<div class="admin-toolbar">
    <h1 class="admin-heading">@T["admin.team.create"]</h1>
    <a class="link-underline" asp-action="Index">@T["admin.back_to_list"]</a>
</div>

<div class="form-card admin-form">
    @* Команда, заведённая администрацией, одобрена сразу и не имеет владельца. *@
    <div class="alert-token" role="status">@T["admin.team.create_notice"]</div>

    <form method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="mb-3"></div>

        <partial name="_TeamFields" model="Model" />

        <div class="admin-form__actions">
            <button class="btn-solid" type="submit">@T["admin.create"]</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/file-validation.js" asp-append-version="true"></script>
}
