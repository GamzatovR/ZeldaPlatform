@using Microsoft.AspNetCore.Mvc.Localization
@using ZeldaArena.Application.Common.Files
@using ZeldaArena.Domain.Enums
@model ZeldaArena.Web.Areas.Admin.Models.Teams.TeamFormViewModel
@inject IHtmlLocalizer<SharedResource> T

<div class="row g-3">
    <div class="col-12 col-md-8">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name"></span>
    </div>

    <div class="col-12 col-md-4">
        <label asp-for="Tag" class="form-label"></label>
        <input asp-for="Tag" class="form-control" />
        <span asp-validation-for="Tag"></span>
    </div>

    <div class="col-12 col-md-4">
        <label asp-for="CountryCode" class="form-label"></label>
        <input asp-for="CountryCode" class="form-control" maxlength="2" />
        <span asp-validation-for="CountryCode"></span>
    </div>

    <div class="col-12 col-md-4">
        <label asp-for="Region" class="form-label"></label>
        <select asp-for="Region" class="form-select">
            @foreach (var region in Enum.GetValues<Region>())
            {
                <option value="@region">@T[EnumResourceKeys.For(region)]</option>
            }
        </select>
        <span asp-validation-for="Region"></span>
    </div>

    <div class="col-12 col-md-4">
        <label asp-for="FoundedAt" class="form-label"></label>
        <input asp-for="FoundedAt" class="form-control" type="date" max="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="FoundedAt"></span>
    </div>

    <div class="col-12 col-md-4">
        <label asp-for="Rating" class="form-label"></label>
        <input asp-for="Rating" class="form-control" type="number" min="0"
               max="@ZeldaArena.Application.Features.Admin.Teams.TeamRatingRules.MaxRating" />
        <span asp-validation-for="Rating"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description"></span>
    </div>

    <div class="col-12 col-md-8">
        <label asp-for="Logo" class="form-label"></label>
        <input asp-for="Logo" class="form-control" type="file" accept="@ImageUploadRules.AcceptAttribute" />
        <span class="form-hint">@T["file.image_hint"]</span>
        <span asp-validation-for="Logo"></span>
    </div>

    @if (Model.CurrentLogoPath is not null)
    {
        <div class="col-12 col-md-4 admin-current-image">
            <avatar image="@Url.StoredFile(Model.CurrentLogoPath)" name="@Model.Name" />
            <div class="form-check">
                <input asp-for="RemoveLogo" class="form-check-input" />
                <label asp-for="RemoveLogo" class="form-check-label"></label>
            </div>
        </div>
    }
</div>
