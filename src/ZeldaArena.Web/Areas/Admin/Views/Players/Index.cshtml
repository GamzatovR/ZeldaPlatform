@using Microsoft.AspNetCore.Mvc.Localization
@using ZeldaArena.Application.Common.Models
@using ZeldaArena.Application.Features.Admin.Players.Queries.GetPlayersForAdmin
@using ZeldaArena.Domain.Enums
@model ZeldaArena.Web.Areas.Admin.Models.Players.PlayerIndexViewModel
@inject IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["admin.nav.players"].Value;
    var filter = Model.Filter;
}

<div class="admin-toolbar">
    <h1 class="admin-heading">@T["admin.nav.players"]</h1>
    <a class="btn-solid btn-solid--sm" asp-action="Create">@T["admin.player.create"]</a>
</div>

<form class="filters" method="get" asp-action="Index" role="search" data-filter-form aria-label="@T["filter.title"]">
    <input type="hidden" name="sort" value="@Model.Sort" data-list-state data-default="@AdminPlayerSorting.Map.DefaultKey" />

    <div class="row g-3">
        <div class="col-12 col-md-6 col-xl-3">
            <label class="form-label" for="search">@T["filter.search"]</label>
            <input class="form-control" id="search" name="search" type="search" value="@filter.Search"
                   maxlength="@GetPlayersForAdminQueryValidator.MaxSearchLength" />
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <label class="form-label" for="role">@T["admin.team.role"]</label>
            <select class="form-select" id="role" name="role">
                <option value="">@T["filter.any"]</option>
                @foreach (var role in Enum.GetValues<PlayerRole>())
                {
                    <option value="@role" selected="@(filter.Role == role)">@T[EnumResourceKeys.For(role)]</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <label class="form-label" for="isFreeAgent">@T["admin.player.team"]</label>
            <select class="form-select" id="isFreeAgent" name="isFreeAgent">
                <option value="">@T["filter.any"]</option>
                <option value="true" selected="@(filter.IsFreeAgent == true)">@T["admin.player.free_agents"]</option>
                <option value="false" selected="@(filter.IsFreeAgent == false)">@T["admin.player.signed"]</option>
            </select>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <label class="form-label" for="pageSize">@T["filter.page_size"]</label>
            <select class="form-select" id="pageSize" name="pageSize" data-default="@PageSizes.Default" data-no-chip>
                @foreach (var size in PageSizes.Allowed)
                {
                    <option value="@size" selected="@(size == filter.NormalizedPageSize)">@size</option>
                }
            </select>
        </div>
    </div>

    <div class="chips" data-filter-chips tabindex="-1" role="group" hidden
         aria-label="@T["filter.active"]" data-remove-label="@T["filter.remove_chip"]"></div>

    <div class="filters__actions">
        <button class="btn-solid" type="submit">@T["filter.apply"]</button>
        <a class="filters__reset" asp-action="Index" data-filter-reset>@T["filter.reset"]</a>
    </div>
</form>

<div id="player-table" data-list data-api="@Url.Action("Index", "AdminPlayersApi", new { area = "Api" })">
    <partial name="_PlayerTable" model="Model" />
</div>
