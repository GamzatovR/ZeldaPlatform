@{
    Layout = "/Views/Shared/_Layout.cshtml";

    var pageTitle = new PageTitleViewModel(T["account.page_title"].Value);
}

@*
    Общая рамка страниц входа, регистрации, восстановления пароля и 2FA.
    Свёрстано по .login-form из docs/design/pages/login.html — это единственные
    страницы аккаунта, у которых макет есть (docs/SPEC.md §9.3 п. 16).
*@
<partial name="/Views/Shared/_PageTitle.cshtml" model="pageTitle" />

<section class="auth">
    <div class="container">
        <div class="row auth__row">
            <div class="col-12 col-md-9 col-lg-6">
                <div class="form-card">
                    <h1>@ViewData["Title"]</h1>

                    <partial name="_StatusMessage" />

                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
</section>

@await RenderSectionAsync("Scripts", required: false)
