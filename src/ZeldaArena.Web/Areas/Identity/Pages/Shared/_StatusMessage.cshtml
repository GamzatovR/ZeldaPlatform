@* Сообщение об исходе действия, пережившее редирект (PRG). *@
@{
    var message = TempData[ZeldaArena.Web.Constants.TempDataKeys.StatusMessage] as string;
    var isError = message is not null && message.StartsWith("!", StringComparison.Ordinal);
}

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert-token @(isError ? "alert-token--error" : "alert-token--success")" role="status">
        @(isError ? message[1..] : message)
    </div>
}
