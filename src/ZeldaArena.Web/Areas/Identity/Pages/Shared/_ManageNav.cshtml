@*
    Навигация по кабинету. Активный пункт помечает тег-хелпер <active-route>
    из Фазы 5 (docs/SPEC.md §10.2): он ставит и класс, и aria-current, поэтому
    текущий раздел различим не только по цвету.
*@
<nav aria-label="@T["manage.title"]">
    <ul class="account-nav">
        <li>
            <a class="account-nav__link" asp-page="./Index"
               active-page="/Account/Manage/Index">@T["manage.nav.profile"]</a>
        </li>
        <li>
            <a class="account-nav__link" asp-page="./ChangePassword"
               active-page="/Account/Manage/ChangePassword">@T["manage.nav.password"]</a>
        </li>
        <li>
            <a class="account-nav__link" asp-page="./Email"
               active-page="/Account/Manage/Email">@T["manage.nav.email"]</a>
        </li>
        <li>
            <a class="account-nav__link" asp-page="./TwoFactorAuthentication"
               active-page="/Account/Manage/TwoFactorAuthentication">@T["manage.nav.two_factor"]</a>
        </li>
    </ul>
</nav>
