@{
    Layout = "/Views/Shared/_Layout.cshtml";

    var pageTitle = new PageTitleViewModel(T["manage.title"].Value);
}

@*
    Кабинет: слева навигация по разделам, справа содержимое.
    Макета у кабинета нет (docs/SPEC.md §9.3 п. 17) — собран из тех же токенов
    и компонентов, что и остальные страницы (docs/design/design-system.md).
*@
<partial name="/Views/Shared/_PageTitle.cshtml" model="pageTitle" />

<section class="account">
    <div class="container">
        <div class="account__layout">
            <partial name="_ManageNav" />

            <div>
                <div class="panel">
                    <h2 class="panel__title">@ViewData["Title"]</h2>

                    <partial name="_StatusMessage" />

                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
</section>

@await RenderSectionAsync("Scripts", required: false)
