@page
@model LoginModel
@{
    ViewData["Title"] = T["login.title"].Value;
}

<form method="post" asp-route-returnUrl="@Model.ReturnUrl">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label">@T["field.email"]</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label">@T["field.password"]</label>
        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="Input.RememberMe" class="form-check-input" />
        <label asp-for="Input.RememberMe" class="form-check-label">@T["field.remember_me"]</label>
    </div>

    <button type="submit" class="btn btn-primary w-100">@T["login.submit"]</button>
</form>

@* Ссылка на восстановление пароля появится вместе с самой страницей: тег-хелпер
   asp-page падает, если маршрут не найден, поэтому ссылки добавляются по мере готовности. *@
<div class="mt-3 d-flex flex-column gap-1">
    <a asp-page="./ResendEmailConfirmation">@T["login.resend_confirmation"]</a>
    <span>@T["login.no_account"] <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">@T["login.register_link"]</a></span>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
