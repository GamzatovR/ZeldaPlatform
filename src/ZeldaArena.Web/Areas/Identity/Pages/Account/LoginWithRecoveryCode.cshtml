@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = T["login_recovery.title"].Value;
}

<p>@T["login_recovery.hint"]</p>

<form method="post" asp-route-returnUrl="@Model.ReturnUrl">
    <div asp-validation-summary="ModelOnly" class="form-group" role="alert"></div>

    <div class="form-group">
        <label asp-for="Input.RecoveryCode" class="form-label">@T["field.recovery_code"]</label>
        <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" autofocus />
        <span asp-validation-for="Input.RecoveryCode"></span>
    </div>

    <button type="submit" class="btn-solid btn-block">@T["login_recovery.submit"]</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
