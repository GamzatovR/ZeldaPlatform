@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = T["forgot_password.title"].Value;
}

<p>@T["forgot_password.hint"]</p>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label">@T["field.email"]</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100">@T["forgot_password.submit"]</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
