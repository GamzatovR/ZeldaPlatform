@page
@model ResetPasswordModel
@{
    ViewData["Title"] = T["reset_password.title"].Value;
}

<form method="post">
    <div asp-validation-summary="ModelOnly" class="form-group" role="alert"></div>

    @* Идентификатор и токен пришли из ссылки в письме и переносятся в POST как есть. *@
    <input type="hidden" asp-for="Input.UserId" />
    <input type="hidden" asp-for="Input.Token" />

    <div class="form-group">
        <label asp-for="Input.NewPassword" class="form-label">@T["field.new_password"]</label>
        <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" />
        <div class="form-text">@T["register.password_hint"]</div>
        <span asp-validation-for="Input.NewPassword"></span>
    </div>

    <div class="form-group">
        <label asp-for="Input.ConfirmPassword" class="form-label">@T["field.confirm_new_password"]</label>
        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword"></span>
    </div>

    <button type="submit" class="btn-solid btn-block">@T["reset_password.submit"]</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
