@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = T["resend_confirmation.title"].Value;
}

<form method="post">
    <div asp-validation-summary="ModelOnly" class="form-group" role="alert"></div>

    <div class="form-group">
        <label asp-for="Input.Email" class="form-label">@T["field.email"]</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" />
        <span asp-validation-for="Input.Email"></span>
    </div>

    <button type="submit" class="btn-solid btn-block">@T["resend_confirmation.submit"]</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
