@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = T["confirm_email.title"].Value;
}

@if (Model.Succeeded)
{
    <div class="alert-token alert-token--success" role="alert">@T["confirm_email.success"]</div>
    <a asp-page="./Login" class="btn-solid">@T["login.submit"]</a>
}
else
{
    <div class="alert-token alert-token--error" role="alert">@Model.ErrorMessage</div>
    <a asp-page="./ResendEmailConfirmation" class="btn-ghost">@T["resend_confirmation.submit"]</a>
}
