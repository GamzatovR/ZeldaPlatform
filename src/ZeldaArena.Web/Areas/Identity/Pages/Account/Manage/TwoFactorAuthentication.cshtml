@page
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = T["manage.two_factor.title"].Value;
}

@if (Model.Status is null)
{
    <div class="alert-token alert-token--error" role="alert">@T["account.operation_failed"]</div>
}
else if (Model.Status.IsEnabled)
{
    <div class="alert-token alert-token--success" role="alert">@T["manage.two_factor.enabled"]</div>

    <p>@string.Format(T["manage.two_factor.recovery_left"].Value, Model.Status.RemainingRecoveryCodes)</p>

    <div class="d-flex flex-column gap-2">
        <form method="post" asp-page-handler="GenerateCodes">
            <button type="submit" class="btn-ghost">@T["manage.two_factor.generate_codes"]</button>
        </form>

        @if (Model.Status.IsRequired)
        {
            @* Для роли Admin второй фактор обязателен: кнопки отключения нет,
               и хендлер отвергает попытку независимо от разметки. *@
            <div class="alert-token mb-0" role="alert">@T["manage.two_factor.admin_required"]</div>
        }
        else
        {
            <form method="post" asp-page-handler="Disable">
                <button type="submit" class="btn-ghost">@T["manage.two_factor.disable"]</button>
            </form>
        }
    </div>
}
else
{
    <div class="alert-token alert-token--warning" role="alert">@T["manage.two_factor.disabled"]</div>

    @if (Model.Status.IsRequired)
    {
        <div class="alert-token" role="alert">@T["manage.two_factor.admin_required"]</div>
    }

    <a asp-page="./EnableAuthenticator" class="btn-solid">@T["manage.two_factor.enable"]</a>
}
