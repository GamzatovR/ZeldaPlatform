@page
@model ConfirmEmailChangeModel
@{
    ViewData["Title"] = T["manage.email.title"].Value;
}

@if (Model.Succeeded)
{
    <div class="alert-token alert-token--success" role="alert">@T["manage.email.changed"]</div>
}
else
{
    <div class="alert-token alert-token--error" role="alert">@Model.ErrorMessage</div>
}

<a asp-page="./Email" class="btn-ghost">@T["manage.nav.email"]</a>
