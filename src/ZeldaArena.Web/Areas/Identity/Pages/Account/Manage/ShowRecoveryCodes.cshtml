@page

@model ShowRecoveryCodesModel

@{

    ViewData["Title"] = T["recovery_codes.title"].Value;

}



<div class="alert-token alert-token--warning" role="alert">@T["recovery_codes.warning"]</div>



<ul class="recovery-codes">

    @foreach (var code in Model.Codes)

    {

        <li class="mono">@code</li>

    }

</ul>



<a asp-page="./TwoFactorAuthentication" class="btn-ghost">@T["manage.nav.two_factor"]</a>

