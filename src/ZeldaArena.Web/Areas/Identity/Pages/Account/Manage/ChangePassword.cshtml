@page
@model ChangePasswordModel
@{
    ViewData["Title"] = T["manage.password.title"].Value;
}

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Input.CurrentPassword" class="form-label">@T["field.current_password"]</label>
        <input asp-for="Input.CurrentPassword" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="Input.CurrentPassword" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.NewPassword" class="form-label">@T["field.new_password"]</label>
        <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" />
        <div class="form-text">@T["register.password_hint"]</div>
        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.ConfirmPassword" class="form-label">@T["field.confirm_new_password"]</label>
        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">@T["manage.password.submit"]</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
