@page
@model IndexModel
@{
    ViewData["Title"] = T["manage.profile.title"].Value;
}

<dl class="definition-list mb-4">
    <dt>@T["field.email"]</dt>
    <dd>@Model.Email</dd>

    <dt>@T["manage.profile.roles"]</dt>
    <dd>@Model.Roles</dd>

    <dt>@T["manage.profile.created_at"]</dt>
    <dd>@Model.CreatedAt.ToLocalTime().ToString("g")</dd>

    <dt>@T["manage.profile.last_login"]</dt>
    <dd>@(Model.LastLoginAt?.ToLocalTime().ToString("g") ?? "—")</dd>
</dl>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="form-group" role="alert"></div>

    <div class="form-group">
        <label asp-for="Input.DisplayName" class="form-label">@T["field.display_name"]</label>
        <input asp-for="Input.DisplayName" class="form-control" autocomplete="nickname" />
        <span asp-validation-for="Input.DisplayName"></span>
    </div>

    <div class="form-group">
        <label asp-for="Input.CountryCode" class="form-label">@T["field.country"]</label>
        <input asp-for="Input.CountryCode" class="form-control" maxlength="2" placeholder="RU" />
        <span asp-validation-for="Input.CountryCode"></span>
    </div>

    <div class="form-group">
        <label asp-for="Input.PreferredCulture" class="form-label">@T["field.culture"]</label>
        <select asp-for="Input.PreferredCulture" asp-items="Model.Cultures" class="form-select"></select>
        <span asp-validation-for="Input.PreferredCulture"></span>
    </div>

    <button type="submit" class="btn-solid">@T["manage.profile.submit"]</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
