@page
@model EmailModel
@{
    ViewData["Title"] = T["manage.email.title"].Value;
}

<p class="text-muted-token">@T["manage.email.current"]: <strong>@Model.CurrentEmail</strong></p>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="form-group" role="alert"></div>

    <div class="form-group">
        <label asp-for="Input.NewEmail" class="form-label">@T["field.new_email"]</label>
        <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" />
        <span asp-validation-for="Input.NewEmail"></span>
    </div>

    <button type="submit" class="btn-solid">@T["manage.email.submit"]</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
