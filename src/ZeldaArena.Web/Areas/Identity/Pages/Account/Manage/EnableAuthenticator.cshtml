@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = T["enable_authenticator.title"].Value;
}

<ol class="mb-4">
    <li>@T["enable_authenticator.step_install"]</li>
    <li>
        @T["enable_authenticator.step_scan"]

        @* QR нарисован на сервере, поэтому виден и без JavaScript.
           Ключ и ссылка — секрет, наружу они уходят только на этой странице. *@
        @* Светлая подложка обязательна: страница тёмная, а QR рисуется тёмными
           модулями — на фоне --color-bg камера его не прочтёт. *@
        <div class="authenticator-qr my-3" aria-hidden="true">@Html.Raw(Model.QrCodeSvg)</div>

        <p class="mono">@Model.SharedKey</p>
    </li>
    <li>@T["enable_authenticator.step_verify"]</li>
</ol>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="form-group" role="alert"></div>

    <div class="form-group">
        <label asp-for="Input.VerificationCode" class="form-label">@T["field.two_factor_code"]</label>
        <input asp-for="Input.VerificationCode" class="form-control" autocomplete="one-time-code"
               inputmode="numeric" />
        <span asp-validation-for="Input.VerificationCode"></span>
    </div>

    <button type="submit" class="btn-solid">@T["enable_authenticator.submit"]</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
