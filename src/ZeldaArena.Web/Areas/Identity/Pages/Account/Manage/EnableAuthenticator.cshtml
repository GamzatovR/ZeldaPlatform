@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = T["enable_authenticator.title"].Value;
}

<ol class="mb-4">
    <li class="mb-3">@T["enable_authenticator.step_install"]</li>
    <li class="mb-3">
        @T["enable_authenticator.step_scan"]

        @* QR нарисован на сервере, поэтому виден и без JavaScript.
           Ключ и ссылка — секрет, наружу они уходят только на этой странице. *@
        <div class="my-3" aria-hidden="true">@Html.Raw(Model.QrCodeSvg)</div>

        <p class="font-monospace">@Model.SharedKey</p>
    </li>
    <li>@T["enable_authenticator.step_verify"]</li>
</ol>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Input.VerificationCode" class="form-label">@T["field.two_factor_code"]</label>
        <input asp-for="Input.VerificationCode" class="form-control" autocomplete="one-time-code"
               inputmode="numeric" />
        <span asp-validation-for="Input.VerificationCode" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">@T["enable_authenticator.submit"]</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
