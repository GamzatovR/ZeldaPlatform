<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>ZeldaArena.Web</RootNamespace>
  </PropertyGroup>

  <!--
    Ссылка на Infrastructure нужна единственно ради AddInfrastructure() в Program.cs
    (docs/SPEC.md §5.2, правило 3) — остальной код Web о ней не знает.
  -->
  <ItemGroup>
    <ProjectReference Include="..\ZeldaArena.Application\ZeldaArena.Application.csproj" />
    <ProjectReference Include="..\ZeldaArena.Infrastructure\ZeldaArena.Infrastructure.csproj" />
  </ItemGroup>

  <!-- QR-код настройки аутентификатора рисуется на сервере (docs/SPEC.md §8.2):
       так он работает и без JavaScript, и без вендорской библиотеки в wwwroot. -->
  <ItemGroup>
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <!-- Фаза 5: SCSS собирается в wwwroot/css на сборке, настройки — в sasscompiler.json. -->
  <ItemGroup>
    <PackageReference Include="AspNetCore.SassCompiler" />
  </ItemGroup>

  <!--
    Путь wwwroot/scss задан спецификацией (docs/SPEC.md §9.1), но исходники стилей —
    не статика: наружу должен уходить только собранный CSS. Поэтому каталог исключён
    из Content и не попадает ни в манифест MapStaticAssets, ни в публикацию.
    Здесь же лежат исходники Bootstrap (wwwroot/scss/vendor, восстанавливаются
    по libman.json) — из них через @use берутся только нужные части.
  -->
  <ItemGroup>
    <Content Remove="wwwroot\scss\**" />
    <None Include="wwwroot\scss\**" />
  </ItemGroup>

  <!-- Инструменты dotnet ef: миграции создаются с проектом запуска Web (CLAUDE.md, «Команды»). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>