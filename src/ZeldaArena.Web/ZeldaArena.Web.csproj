<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>ZeldaArena.Web</RootNamespace>
  </PropertyGroup>

  <!--
    Ссылка на Infrastructure нужна единственно ради AddInfrastructure() в Program.cs
    (docs/SPEC.md §5.2, правило 3) — остальной код Web о ней не знает.
  -->
  <ItemGroup>
    <ProjectReference Include="..\ZeldaArena.Application\ZeldaArena.Application.csproj" />
    <ProjectReference Include="..\ZeldaArena.Infrastructure\ZeldaArena.Infrastructure.csproj" />
  </ItemGroup>

  <!-- QR-код настройки аутентификатора рисуется на сервере (docs/SPEC.md §8.2):
       так он работает и без JavaScript, и без вендорской библиотеки в wwwroot. -->
  <ItemGroup>
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <!-- Инструменты dotnet ef: миграции создаются с проектом запуска Web (CLAUDE.md, «Команды»). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>