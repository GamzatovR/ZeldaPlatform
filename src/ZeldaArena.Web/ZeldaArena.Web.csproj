<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>ZeldaArena.Web</RootNamespace>
  </PropertyGroup>

  <!-- Ссылка на Infrastructure нужна ради AddInfrastructure() в Program.cs, больше нигде. -->
  <ItemGroup>
    <ProjectReference Include="..\ZeldaArena.Application\ZeldaArena.Application.csproj" />
    <ProjectReference Include="..\ZeldaArena.Infrastructure\ZeldaArena.Infrastructure.csproj" />
  </ItemGroup>

  <!-- QR-код аутентификатора рисуется на сервере: без JavaScript и без вендорской библиотеки. -->
  <ItemGroup>
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <!-- Фаза 5: SCSS собирается в wwwroot/css на сборке, настройки — в sasscompiler.json. -->
  <ItemGroup>
    <PackageReference Include="AspNetCore.SassCompiler" />
  </ItemGroup>

  <!-- wwwroot/scss не статика: наружу уходит только собранный CSS, поэтому каталог
       исключён из Content, из манифеста MapStaticAssets и из публикации. -->
  <ItemGroup>
    <Content Remove="wwwroot\scss\**" />
    <None Include="wwwroot\scss\**" />
  </ItemGroup>

  <!-- Инструменты dotnet ef: миграции создаются с проектом запуска Web. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>