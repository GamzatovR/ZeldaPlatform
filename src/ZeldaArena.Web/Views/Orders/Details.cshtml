@using Microsoft.AspNetCore.Mvc.Localization
@using ZeldaArena.Web.Extensions
@using ZeldaArena.Web.Models.Layout
@model ZeldaArena.Application.Features.Orders.Queries.GetOrderDetails.OrderDetailsDto
@inject IHtmlLocalizer<SharedResource> T
@inject IStringLocalizer<SharedResource> L
@{
    // IStringLocalizer, а не IHtmlLocalizer: у LocalizedHtmlString свойство Value —
    // шаблон без подстановки аргументов («Заказ {0}»), форматирует он только при выводе.
    var title = L["order.details_title", Model.Number].Value;

    ViewData["Title"] = title;

    var pageTitle = new PageTitleViewModel(title, Compact: true);
}

@*
    Детали заказа (docs/SPEC.md §9.3, п. 15). Названия и цены — снапшоты на момент
    оформления (§6): каталог мог измениться, заказ — нет.

    Действия зависят от статуса, и решает это сервер (CanCancel, CanContinuePayment):
    покупатель отменяет только неоплаченный заказ (docs/adr/ADR-0009).
*@
<partial name="_PageTitle" model="pageTitle" />

<section class="section">
    <div class="container">
        <partial name="_StatusMessage" />

        <div class="row g-4">
            <div class="col-12 col-lg-8">
                <div class="table-responsive">
                    <table class="table table-token">
                        <caption class="visually-hidden">@T["order.lines"]</caption>
                        <thead>
                            <tr>
                                <th scope="col">@T["cart.col_product"]</th>
                                <th scope="col">@T["cart.col_price"]</th>
                                <th scope="col">@T["cart.col_quantity"]</th>
                                <th scope="col" class="text-end">@T["cart.col_total"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in Model.Lines)
                            {
                                <tr>
                                    <td>@line.ProductName</td>
                                    <td>@MoneyText.Format(line.UnitPrice, Model.Currency)</td>
                                    <td>@line.Quantity</td>
                                    <td class="text-end">@MoneyText.Format(line.LineTotal, Model.Currency)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th scope="row" colspan="3">@T["order.total"]</th>
                                <td class="text-end order-summary__total">@MoneyText.Format(Model.Total, Model.Currency)</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="order-summary">
                    <dl class="order-summary__list">
                        <dt>@T["order.status"]</dt>
                        <dd><span class="@OrderStatusBadge.CssFor(Model.Status)">@T[EnumResourceKeys.For(Model.Status)]</span></dd>

                        <dt>@T["order.placed_at"]</dt>
                        <dd><time datetime="@Model.PlacedAt.ToString("O")">@Model.PlacedAt.ToLocalTime().ToString("g")</time></dd>

                        @if (Model.PaidAt is { } paidAt)
                        {
                            <dt>@T["order.paid_at"]</dt>
                            <dd><time datetime="@paidAt.ToString("O")">@paidAt.ToLocalTime().ToString("g")</time></dd>
                        }

                        @if (Model.CanceledAt is { } canceledAt)
                        {
                            <dt>@T["order.canceled_at"]</dt>
                            <dd><time datetime="@canceledAt.ToString("O")">@canceledAt.ToLocalTime().ToString("g")</time></dd>
                        }

                        <dt>@T["order.shipping_to"]</dt>
                        <dd>
                            @Model.Recipient, @Model.Phone<br />
                            @Model.PostalCode, @Model.Country, @Model.City<br />
                            @Model.Street
                        </dd>
                    </dl>

                    @if (Model.CanContinuePayment)
                    {
                        <a class="btn-solid btn-block" asp-controller="Payment" asp-action="Confirm" asp-route-id="@Model.PendingPaymentId">
                            @T["order.continue_payment"]
                        </a>
                    }

                    @if (Model.CanCancel)
                    {
                        <form class="mt-3" method="post" asp-controller="Orders" asp-action="Cancel" asp-route-number="@Model.Number">
                            <button class="btn-ghost btn-block" type="submit">@T["order.cancel"]</button>
                        </form>
                    }
                </div>
            </div>
        </div>

        <p class="mt-4">
            <a class="link-underline" asp-controller="Orders" asp-action="Index">@T["order.back_to_list"]</a>
        </p>
    </div>
</section>
