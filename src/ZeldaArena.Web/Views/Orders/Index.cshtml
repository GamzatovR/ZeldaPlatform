@using Microsoft.AspNetCore.Mvc.Localization
@using ZeldaArena.Application.Common.Models
@using ZeldaArena.Application.Features.Orders.Queries.GetMyOrders
@using ZeldaArena.Domain.Enums
@using ZeldaArena.Web.Extensions
@using ZeldaArena.Web.Models.Layout
@model ZeldaArena.Web.Models.Orders.OrderListViewModel
@inject IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["order.list_title"].Value;

    var pageTitle = new PageTitleViewModel(T["order.list_title"].Value, T["order.list_sub"].Value, Compact: true);
    var filter = Model.Filter;
    var sort = OrderSorting.Map.Resolve(filter.Sort);
}

@* История заказов. *@
<partial name="_PageTitle" model="pageTitle" />

<section class="section">
    <div class="container">
        <form class="filters" method="get" asp-action="Index" role="search" data-filter-form
              aria-label="@T["filter.title"]">
            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <label class="form-label" for="status">@T["order.status"]</label>
                    <select class="form-select" id="status" name="status">
                        <option value="">@T["filter.any"]</option>
                        @foreach (var status in Enum.GetValues<OrderStatus>())
                        {
                            <option value="@status" selected="@(filter.Status == status)">@T[EnumResourceKeys.For(status)]</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label" for="sort">@T["filter.sort"]</label>
                    <select class="form-select" id="sort" name="sort"
                            data-default="@OrderSorting.Map.DefaultKey" data-no-chip>
                        @foreach (var key in OrderSorting.Map.Keys)
                        {
                            <option value="@key" selected="@(key == sort)">@T["order.sort." + key]</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label" for="pageSize">@T["filter.page_size"]</label>
                    <select class="form-select" id="pageSize" name="pageSize"
                            data-default="@PageSizes.Default" data-no-chip>
                        @foreach (var size in PageSizes.Allowed)
                        {
                            <option value="@size" selected="@(size == filter.NormalizedPageSize)">@size</option>
                        }
                    </select>
                </div>
            </div>

            <div class="chips" data-filter-chips tabindex="-1" role="group" hidden
                 aria-label="@T["filter.active"]" data-remove-label="@T["filter.remove_chip"]"></div>

            <div class="filters__actions">
                <button class="btn-solid" type="submit">@T["filter.apply"]</button>
                <a class="filters__reset" asp-action="Index" data-filter-reset>@T["filter.reset"]</a>
            </div>
        </form>

        <div id="order-list" data-list data-api="@Url.Action("Index", "OrdersApi", new { area = "Api" })">
            <partial name="_OrderList" model="Model.Result" />
        </div>
    </div>
</section>
