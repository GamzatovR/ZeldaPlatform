@using Microsoft.AspNetCore.Mvc.Localization
@using ZeldaArena.Web.Constants
@using ZeldaArena.Web.Extensions
@model ZeldaArena.Web.Models.Home.HomeViewModel
@inject IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["home.title"].Value;
}

@*
    Главная (docs/SPEC.md §9.3, страница 1). Свёрстана по docs/design/pages/home.html.

    Слайдер трейлеров, партнёры, награды и подменённый курсор из макета не
    переносятся: они держатся на owl.carousel, wow.js и cursor.js, которых
    в выданном шаблоне нет (docs/design/design-system.md §1, §13).

    Бегущая строка live-матчей придёт в Фазе 10 со своим сценарием, заглушки под неё
    не ставим. Топ-команды — с Фазы 6, по блоку участников pages/tournament.html;
    витрина товаров — с Фазы 7, по блоку магазина pages/home.html.
*@

<section class="hero">
    <div class="container hero__inner">
        <span class="hero__sub">@T["home.hero_sub"]</span>

        <div class="hero__logo">
            <img src="~/img/zelda.png" alt="@T["brand.name"]" />
        </div>

        <p class="hero__tagline">@T["home.hero_tagline"]</p>

        <div class="hero__actions">
            <a class="btn-solid" asp-controller="Subscription" asp-action="Index">
                <icon name="@IconNames.Trophy" /> @T["home.hero_cta"]
            </a>
            <a class="btn-ghost" href="#matches">@T["home.hero_matches"]</a>
        </div>
    </div>
</section>

<section class="section" id="matches">
    <div class="container">
        <div class="section-title">
            <span class="sub-title">@T["home.matches_sub"]</span>
            <h2>@T["home.matches_title"]</h2>
        </div>

        @if (Model.Matches.Count == 0)
        {
            @* Пустое состояние показывается отдельно, а не пустым местом (§10.2). *@
            <p class="empty-state">@T["home.matches_empty"]</p>
        }
        else
        {
            foreach (var match in Model.Matches)
            {
                <partial name="_MatchCard" model="match" />
            }
        }
    </div>
</section>

<section class="section section--surface">
    <div class="container">
        <div class="section-title">
            <span class="sub-title">@T["home.news_sub"]</span>
            <h2>@T["home.news_title"]</h2>
        </div>

        @if (Model.News.Count == 0)
        {
            <p class="empty-state">@T["home.news_empty"]</p>
        }
        else
        {
            <div class="row">
                @foreach (var article in Model.News)
                {
                    <div class="col-12 col-md-6 col-lg-4 mb-4">
                        <partial name="_NewsCard" model="article" />
                    </div>
                }
            </div>
        }
    </div>
</section>

@if (Model.TopTeams.Count > 0)
{
    <section class="section">
        <div class="container">
            <div class="section-title">
                <span class="sub-title">@T["home.teams_sub"]</span>
                <h2>@T["home.teams_title"]</h2>
            </div>

            <div class="row g-4">
                @foreach (var team in Model.TopTeams)
                {
                    <div class="col-12 col-sm-6 col-lg-3">
                        <article class="entity-card">
                            <avatar image="@Url.StoredFile(team.LogoPath)" name="@team.Name" />

                            <h3 class="entity-card__name">
                                <a asp-controller="Teams" asp-action="Details" asp-route-slug="@team.Slug">@team.Name</a>
                            </h3>

                            <p class="entity-card__caption">@team.Tag · @team.CountryCode</p>

                            <ul class="entity-card__tags">
                                <li><span class="badge-token badge-token--accent">@T["tournament.rating", team.Rating]</span></li>
                            </ul>
                        </article>
                    </div>
                }
            </div>

            <div class="hero__actions mt-4">
                <a class="btn-ghost" asp-controller="Teams" asp-action="Index">@T["home.teams_all"]</a>
            </div>
        </div>
    </section>
}

@if (Model.Products.Count > 0)
{
    <section class="section section--surface" id="shop">
        <div class="container">
            <div class="section-title">
                <span class="sub-title">@T["home.shop_sub"]</span>
                <h2>@T["home.shop_title"]</h2>
            </div>

            @* Исход «в корзину» с витрины: форма карточки возвращает на главную. *@
            <partial name="_StatusMessage" />

            <div class="row g-4">
                @foreach (var product in Model.Products)
                {
                    <div class="col-12 col-sm-6 col-lg-3">
                        <vc:product-card product="product" return-fragment="shop" />
                    </div>
                }
            </div>

            <div class="hero__actions mt-4">
                <a class="btn-ghost" asp-controller="Shop" asp-action="Index">@T["home.shop_all"]</a>
            </div>
        </div>
    </section>
}

@* Фоны секций чередуются: витрина магазина перед этой секцией — на поверхности. *@
<section class="section">
    <div class="container">
        <div class="section-title">
            <span class="sub-title">@T["home.subscribe_sub"]</span>
            <h2>@T["home.subscribe_title"]</h2>
            <p>@T["home.subscribe_text"]</p>
        </div>

        <div class="hero__actions">
            <a class="btn-solid" asp-controller="Subscription" asp-action="Index">@T["home.subscribe_cta"]</a>
        </div>
    </div>
</section>