@using ZeldaArena.Web.Models.Layout
@model ZeldaArena.Web.Models.Billing.ConfirmPaymentViewModel
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["payment.confirm_title"].Value;

    var pageTitle = new PageTitleViewModel(Localizer["payment.confirm_title"].Value);
}

@*
    Шаг 3 мнимой оплаты: ввод кода из письма (docs/SPEC.md §7.6).
    Адрес показан маскированным, самого кода в разметке нет и быть не может —
    в базе от него хранится только хеш.
*@
<partial name="_PageTitle" model="pageTitle" />

<section class="auth">
    <div class="container">
        <div class="row auth__row">
            <div class="col-12 col-md-9 col-lg-6">
                <div class="form-card">
                    <h1>@Localizer["payment.confirm_title"]</h1>

                    <partial name="_StatusMessage" />

                    <p>@Localizer["payment.code_sent_to"] <strong>@Model.MaskedEmail</strong></p>

                    <p class="text-muted-token small-token">
                        @Localizer["payment.attempts_left"] <span data-attempts-left>@Model.AttemptsLeft</span> ·
                        @Localizer["payment.valid_until"] @Model.ExpiresAt.ToLocalTime().ToString("HH:mm")
                    </p>

                    <form method="post" data-ajax-form="@Url.Action("Confirm", "PaymentsApi", new { area = "Api", id = Model.PaymentId })">
                        <div asp-validation-summary="ModelOnly" class="mb-3"></div>

                        <div class="form-group">
                            <label asp-for="ConfirmationCode" class="form-label"></label>
                            <input asp-for="ConfirmationCode" class="form-control"
                                   autocomplete="one-time-code" inputmode="numeric" />
                            <span asp-validation-for="ConfirmationCode"></span>
                        </div>

                        <button type="submit" class="btn-solid btn-block">@Localizer["payment.confirm"]</button>
                    </form>

                    @* Отдельные формы: повторная отправка и отмена — свои действия,
                       а не кнопки той же формы. *@
                    <div class="auth__aside mt-3">
                        <form asp-action="Resend" asp-route-id="@Model.PaymentId" method="post">
                            <button type="submit" class="link-underline" disabled="@(!Model.CanResendNow)">
                                @Localizer["payment.resend"]
                            </button>
                        </form>

                        <form asp-action="Cancel" asp-route-id="@Model.PaymentId" method="post">
                            <button type="submit" class="link-underline">@Localizer["payment.cancel"]</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
