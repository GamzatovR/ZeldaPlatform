@using ZeldaArena.Web.Constants
@using ZeldaArena.Web.Models.Layout
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["payment.success_title"].Value;

    var pageTitle = new PageTitleViewModel(Localizer["payment.success_title"].Value);
}

<partial name="_PageTitle" model="pageTitle" />

<section class="auth">
    <div class="container">
        <div class="row auth__row">
            <div class="col-12 col-md-9 col-lg-6">
                <div class="form-card text-center">
                    <h1>@Localizer["payment.success_title"]</h1>

                    <p>@Localizer["payment.success_body"]</p>

                    <a class="btn-solid" asp-controller="Subscription" asp-action="Index">
                        <icon name="@IconNames.Check" /> @Localizer["subscription.title"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
