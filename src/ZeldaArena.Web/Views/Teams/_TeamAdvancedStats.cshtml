@using Microsoft.AspNetCore.Mvc.Localization
@using ZeldaArena.Application.Features.Teams.Queries.GetTeamAdvancedStats
@model TeamAdvancedStatsDto
@inject IHtmlLocalizer<SharedResource> T

@*
    Расширенная статистика команды (stats.advanced). Графики из §7.2 заменены таблицами —
    это разрешено Приоритетом B (§17) и не тянет в проект библиотеку диаграмм.
*@
<h3 class="details-block__subtitle">@T["team.advanced_players"]</h3>

@if (Model.Players.Count == 0)
{
    <p class="empty-state">@T["match.stats_empty"]</p>
}
else
{
    <div class="table-responsive mb-4">
        <table class="table table-token">
            <thead>
                <tr>
                    <th scope="col">@T["player.nickname"]</th>
                    <th scope="col">@T["stats.matches"]</th>
                    <th scope="col"><abbr title="@T["stats.kills"]">K</abbr></th>
                    <th scope="col"><abbr title="@T["stats.deaths"]">D</abbr></th>
                    <th scope="col"><abbr title="@T["stats.assists"]">A</abbr></th>
                    <th scope="col">KDA</th>
                    <th scope="col">@T["stats.damage"]</th>
                    <th scope="col">@T["stats.rating"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var player in Model.Players)
                {
                    <tr>
                        <td><a asp-controller="Players" asp-action="Details" asp-route-slug="@player.Slug">@player.Nickname</a></td>
                        <td>@player.Matches</td>
                        <td>@player.Kills.ToString("0.0")</td>
                        <td>@player.Deaths.ToString("0.0")</td>
                        <td>@player.Assists.ToString("0.0")</td>
                        <td>@player.Kda.ToString("0.00")</td>
                        <td>@player.Damage.ToString("N0")</td>
                        <td>@player.Rating.ToString("0.00")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h3 class="details-block__subtitle">@T["team.advanced_tournaments"]</h3>

@if (Model.Tournaments.Count == 0)
{
    <p class="empty-state">@T["team.history_empty"]</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-token">
            <thead>
                <tr>
                    <th scope="col">@T["match.tournament"]</th>
                    <th scope="col">@T["team.played"]</th>
                    <th scope="col">@T["team.wins"]</th>
                    <th scope="col">@T["team.win_rate"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var record in Model.Tournaments)
                {
                    <tr>
                        <td><a asp-controller="Tournaments" asp-action="Details" asp-route-slug="@record.Slug">@record.Name</a></td>
                        <td>@record.Played</td>
                        <td>@record.Wins</td>
                        <td>@record.WinRate%</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
