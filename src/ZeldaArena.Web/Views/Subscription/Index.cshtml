@using ZeldaArena.Web.Constants
@using ZeldaArena.Web.Models.Layout
@model ZeldaArena.Web.Models.Billing.SubscriptionPageViewModel
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["subscription.title"].Value;

    var highlighted = Model.PlansGrantingRequiredFeature;
    var pageTitle = new PageTitleViewModel(Localizer["subscription.title"].Value);
}

<partial name="_PageTitle" model="pageTitle" />

<section class="section">
    <div class="container">
        <partial name="_StatusMessage" />

        @if (Model.RequiredFeature is not null)
        {
            @* Пришли по редиректу фича-гейта: нужный тариф подсвечен ниже. *@
            <div class="alert-token alert-token--warning" role="alert">
                <icon name="@IconNames.Lock" />
                <span>@Localizer["subscription.feature_required"]</span>
            </div>
        }

        @if (Model.Current is { } current)
        {
            <section class="panel">
                <h2 class="panel__title">@Localizer["subscription.current"]</h2>

                <dl class="definition-list">
                    <dt>@Localizer["subscription.plans"]</dt>
                    <dd>
                        @current.PlanName
                        @if (current.IsActive)
                        {
                            <span class="badge-token badge-token--success">@Localizer["subscription.active"]</span>
                        }
                        else
                        {
                            <span class="badge-token">@Localizer["subscription.inactive"]</span>
                        }
                    </dd>

                    <dt>@Localizer["subscription.valid_until"]</dt>
                    <dd>@current.EndsAt.ToLocalTime().ToString("d")</dd>
                </dl>

                @if (current.IsActive && current.AutoRenew)
                {
                    <form asp-action="Cancel" method="post" class="mt-3">
                        <button type="submit" class="btn-ghost">@Localizer["subscription.cancel_renewal"]</button>
                    </form>
                }
                else if (current.IsActive)
                {
                    <p class="text-muted-token mt-3">@Localizer["subscription.renewal_off"]</p>
                }
            </section>
        }

        <div class="section-title">
            <h2>@Localizer["subscription.plans"]</h2>
        </div>

        <div class="row">
            @foreach (var plan in Model.Plans)
            {
                <div class="col-12 col-md-6 col-lg-4 mb-4">
                    <div class="plan-card @(highlighted.Contains(plan.Id) ? "plan-card--highlighted" : null)">
                        <h3 class="plan-card__name">@plan.Name</h3>

                        @if (plan.IsFree)
                        {
                            <span class="plan-card__price">@Localizer["subscription.free"]</span>
                        }
                        else
                        {
                            <span class="plan-card__price">@($"{plan.Price:N0} {plan.Currency}")</span>
                            <span class="plan-card__period">
                                @plan.DurationDays @Localizer["subscription.days"]
                            </span>
                        }

                        <p class="text-muted-token">@plan.Description</p>

                        <ul class="plan-card__features">
                            @foreach (var feature in plan.Features)
                            {
                                <li class="plan-card__feature">
                                    <icon name="@IconNames.Check" />
                                    <span>@feature.Name</span>
                                </li>
                            }
                        </ul>

                        @if (!plan.IsFree)
                        {
                            <a class="btn-solid btn-block"
                               asp-controller="Payment"
                               asp-action="Card"
                               asp-route-planId="@plan.Id">@Localizer["subscription.buy"]</a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>
