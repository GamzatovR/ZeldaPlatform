@using Microsoft.AspNetCore.Mvc.Localization
@using ZeldaArena.Web.Constants
@inject IHtmlLocalizer<SharedResource> T
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    @*
        Антифоржери-токен для AJAX (docs/SPEC.md §10.1, §15): http.js кладёт его
        в заголовок RequestVerificationToken каждого изменяющего запроса.
    *@
    <meta name="request-verification-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>@ViewData["Title"] — @T["brand.name"]</title>

    @*
        Teko и Poppins — шрифты макета; их файлов в шаблоне нет, поэтому пока
        Google Fonts. Перевод на самостоятельный хостинг и CSP под шрифты —
        Фаза 11 (docs/design/design-system.md §4).
    *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Teko:wght@@400;500;600;700&family=Poppins:wght@@400;500;600&display=swap" />

    @* Собирается dart-sass из wwwroot/scss на каждой сборке. *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    @* Обход клавиатурой: в макете пропуска к содержимому нет (§9.1). *@
    <a class="skip-link" href="#main">@T["a11y.skip_to_content"]</a>

    @await Component.InvokeAsync("Header")

    <main id="main">
        @RenderBody()
    </main>

    @await Component.InvokeAsync("Footer")

    <button class="go-top" type="button" data-go-top hidden>
        <icon name="@IconNames.ArrowUp" label="@T["a11y.back_to_top"]" />
    </button>

    @*
        Скрипты — ES-модули (docs/SPEC.md §2). Из 14 файлов шаблона в макете
        лежит только main.js, поэтому поведение написано заново и переносится
        лишь то, что действительно используется (CLAUDE.md, «Работа с макетами»).
        jQuery подключается страницами форм ради jquery-validation-unobtrusive
        и только там — секция Scripts.
    *@
    <script type="module" src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
