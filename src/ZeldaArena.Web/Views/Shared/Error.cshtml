@using Microsoft.AspNetCore.Mvc.Localization
@using ZeldaArena.Web.Constants
@model ErrorViewModel
@inject IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["error.500.title"].Value;
    Layout = "_ErrorLayout";
}

@*
    Свёрстано по docs/design/pages/404.html — это образец для всех страниц ошибок
    (docs/SPEC.md §14.2). Остальные коды и ErrorController приходят в Фазе 11.
*@
<section class="error-page">
    <div class="container">
        <div class="error-page__image">
            <img src="~/img/error.png" alt="" />
        </div>

        <span class="error-page__code">500</span>
        <h1 class="error-page__title">@T["error.500.title"]</h1>
        <p class="error-page__text">@T["error.500.text"]</p>

        @if (Model.ShowRequestId)
        {
            @* Идентификатор для обращения в поддержку. Стек и подробности
               исключения наружу не отдаются (§14.2). *@
            <p class="error-page__trace">@T["error.trace_id"]: <code>@Model.RequestId</code></p>
        }

        <div class="error-page__actions">
            <a class="btn-solid" asp-controller="Home" asp-action="Index">
                <icon name="@IconNames.ArrowUp" /> @T["error.go_home"]
            </a>
        </div>
    </div>
</section>
