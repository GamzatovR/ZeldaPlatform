@using Microsoft.AspNetCore.Mvc.Localization
@using ZeldaArena.Web.Constants
@using ZeldaArena.Web.Extensions
@model ZeldaArena.Web.Models.Shop.ProductCardViewModel
@inject IHtmlLocalizer<SharedResource> T
@{
    var product = Model.Product;
    var image = Url.ProductImage(product.ImagePath);
}

@* Карточка товара — .single-products-box макета. *@
<article class="product-card" data-product-id="@product.Id">
    <div class="product-card__image">
        @if (image is not null)
        {
            <img src="@image" alt="@product.Name" loading="lazy" width="400" height="400" />
        }
        else
        {
            <span class="product-card__placeholder"><icon name="@IconNames.Cart" /></span>
        }
    </div>

    @if (!product.IsInStock)
    {
        <span class="product-card__badge product-card__badge--out">@T["shop.out_of_stock"]</span>
    }
    else if (product.IsLowStock)
    {
        <span class="product-card__badge">@T["shop.low_stock", product.StockQuantity]</span>
    }

    <div class="product-card__content">
        <span class="product-card__category">@product.CategoryName</span>
        <h3 class="product-card__name">@product.Name</h3>
        <span class="product-card__price">@MoneyText.Format(product.Price, product.Currency)</span>

        <div class="product-card__actions">
            @if (product.IsInStock)
            {
                @* Обычная POST-форма. *@
                <form method="post" asp-area="" asp-controller="Cart" asp-action="Add"
                      data-add-to-cart="@Url.Action("Add", "CartApi", new { area = "Api" })">
                    <input type="hidden" name="ProductId" value="@product.Id" />
                    <input type="hidden" name="Quantity" value="1" />
                    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                    <button class="btn-solid btn-block" type="submit">
                        <icon name="@IconNames.Cart" /> @T["shop.add_to_cart"]
                        <span class="visually-hidden">: @product.Name</span>
                    </button>
                </form>
            }
            else
            {
                <button class="btn-ghost btn-block" type="button" disabled>@T["shop.out_of_stock"]</button>
            }
        </div>
    </div>
</article>
