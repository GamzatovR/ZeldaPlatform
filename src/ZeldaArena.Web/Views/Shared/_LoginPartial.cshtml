@using Microsoft.AspNetCore.Mvc.Localization
@using ZeldaArena.Domain.Constants
@inject IHtmlLocalizer<SharedResource> T

@*
    Вход и выход в шапке. Выход — форма, а не ссылка: изменяющий запрос обязан идти
    POST с антифоржери-токеном (docs/SPEC.md §15).
*@
<ul class="navbar-nav">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index">@T["nav.manage"]</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="" asp-controller="Subscription" asp-action="Index">@T["nav.subscription"]</a>
        </li>
        @* Бейдж подписчика. Роль Premium здесь именно для отображения и ни для чего
           больше — доступ дают фичи (docs/SPEC.md §7.4). *@
        @if (User.IsInRole(RoleNames.Premium))
        {
            <li class="nav-item d-flex align-items-center">
                <span class="badge bg-warning text-dark">@T["nav.premium"]</span>
            </li>
        }
        <li class="nav-item">
            <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Content("~/")">
                <button type="submit" class="nav-link btn btn-link text-dark">@T["nav.logout"]</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">@T["nav.register"]</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">@T["nav.login"]</a>
        </li>
    }
</ul>
