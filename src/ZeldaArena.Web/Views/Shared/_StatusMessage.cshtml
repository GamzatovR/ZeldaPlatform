@*
    Сообщение об исходе действия, пережившее редирект (PRG). Держится в TempData,
    поэтому показывается ровно один раз.

    Признак ошибки — ведущий «!», как это заведено в страницах аккаунта Фазы 3.
    role="status" вместо alert: сообщение появляется после перехода, а не
    прерывает работу, и перебивать им скринридер не нужно.
*@
@{
    var message = TempData["StatusMessage"] as string;
    var isError = message is not null && message.StartsWith("!", StringComparison.Ordinal);
}

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert-token @(isError ? "alert-token--error" : "alert-token--success")" role="status">
        @(isError ? message[1..] : message)
    </div>
}
