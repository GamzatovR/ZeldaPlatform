@using ZeldaArena.Application.Features.News.Queries.GetLatestNews
@model NewsListItemDto

@*
    Карточка новости по .single-blog-post-item макета. Заголовок — ссылка на /news/{slug}
    (Фаза 6); вся карточка кликабельна через растянутую ссылку, как у карточек команд.

    У новостей из сида обложки нет: поле CoverPath пустое, поэтому блок картинки
    выводится только при её наличии, а карточка обязана оставаться целой без неё.
*@
<article class="news-card">
    @if (Model.CoverPath is not null)
    {
        <div class="news-card__image">
            <img src="@Model.CoverPath" alt="" loading="lazy" />
        </div>
    }

    <div class="news-card__body">
        @if (Model.PublishedAt is { } publishedAt)
        {
            <time class="news-card__date" datetime="@publishedAt.ToString("O")">
                @publishedAt.ToLocalTime().ToString("d")
            </time>
        }

        <h3 class="news-card__title">
            <a class="news-card__link" asp-controller="News" asp-action="Details" asp-route-slug="@Model.Slug">@Model.Title</a>
        </h3>

        @if (!string.IsNullOrWhiteSpace(Model.Summary))
        {
            <p class="news-card__summary">@Model.Summary</p>
        }
    </div>
</article>