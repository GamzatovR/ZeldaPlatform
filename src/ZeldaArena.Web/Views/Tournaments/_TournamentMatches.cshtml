@using Microsoft.AspNetCore.Mvc.Localization
@using ZeldaArena.Application.Common.Models
@using ZeldaArena.Application.Common.Models.Esports
@model PagedResult<MatchCardDto>
@inject IHtmlLocalizer<SharedResource> T

@* Матчи выбранной вкладки. *@
@if (Model.TotalCount == 0)
{
    <p class="empty-state">@T["tournament.matches_empty"]</p>
}
else
{
    foreach (var match in Model.Items)
    {
        <partial name="_MatchCard" model="match" />
    }

    <pagination page="@Model.Page" total-pages="@Model.TotalPages" />
}
