@using Microsoft.AspNetCore.Mvc.Localization
@using ZeldaArena.Application.Common.Models
@using ZeldaArena.Application.Features.Tournaments.Queries.GetTournaments
@model PagedResult<TournamentListItemDto>
@inject IHtmlLocalizer<SharedResource> T

@* Результат фильтра. *@
@if (Model.TotalCount == 0)
{
    <p class="empty-state">@T["filter.empty"]</p>
}
else
{
    <p class="list-summary" aria-live="polite">@T["filter.found", Model.TotalCount]</p>

    <div class="row g-4">
        @foreach (var tournament in Model.Items)
        {
            <div class="col-12 col-sm-6 col-lg-4">
                @* Полный путь: из Areas/Api поиск по имени идёт в папках области. *@
                <partial name="~/Views/Tournaments/_TournamentCard.cshtml" model="tournament" />
            </div>
        }
    </div>

    <pagination page="@Model.Page" total-pages="@Model.TotalPages" />
}
