<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ZeldaArena.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZeldaArena.Application\ZeldaArena.Application.csproj" />
  </ItemGroup>

  <!--
    Фаза 2: IHttpContextAccessor нужен реализации ICurrentUserService, а отдельным
    пакетом в .NET 10 он не ставится — это часть общего фреймворка. Отсюда же в Фазе 10
    придёт IHubContext для SignalR-адаптера. Ссылка на фреймворк заодно снабжает проект
    абстракциями DI, конфигурации и логирования, поэтому явных пакетов на них больше нет
    (иначе NU1510).

    Правило §5.2 не нарушено: запрет на ASP.NET Core действует для Domain и Application.
    Infrastructure реализует порты и вправе знать хост — правило 3 запрещает обратное,
    протечку типов Infrastructure в Web, и оно проверяется отдельным тестом.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" />
  </ItemGroup>

  <!-- Фаза 9: очистка HTML регламента турнира на входе (docs/SPEC.md §15). -->
  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" />
  </ItemGroup>

  <!-- Фаза 1: EF Core и PostgreSQL. Identity здесь ради схемы: первая миграция
       обязана содержать таблицы AspNet* и настоящие FK на AspNetUsers (docs/adr/ADR-0003).
       Сервисы Identity подключаются в Фазе 3. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
  </ItemGroup>

</Project>