<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ZeldaArena.Application</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Только Domain: ни EF Core, ни ASP.NET Core здесь быть не может. -->
  <ItemGroup>
    <ProjectReference Include="..\ZeldaArena.Domain\ZeldaArena.Domain.csproj" />
  </ItemGroup>

  <!-- Фаза 2: CQRS, валидация, маппинг. Фреймворка эти пакеты не тянут — это проверяется тестом. -->
  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Mapster" />
    <PackageReference Include="Mapster.DependencyInjection" />
  </ItemGroup>

  <!-- Абстракции для AddApplication() и behaviors: сами по себе фреймворка не тянут. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>